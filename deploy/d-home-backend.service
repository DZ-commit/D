# D全屋家居 后端 systemd 服务（Linux 生产，可选）
# 用法：sudo cp deploy/d-home-backend.service /etc/systemd/system/ &&
#       sudo systemctl daemon-reload && sudo systemctl enable --now d-home-backend
[Unit]
Description=D全屋家居 Backend (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/d-home/api
# 生产启动：多 worker；.env 中配置 DATABASE_URL/JWT_SECRET 等
ExecStart=/opt/d-home/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
# 安全加固（可选）
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/d-home/api/uploads /opt/d-home/api

[Install]
WantedBy=multi-user.target
