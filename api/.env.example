# D全屋家居 后端环境变量样例
# 部署到 Railway / Render / VPS 时，在对应平台的环境变量设置里填写（不要提交真实 .env）。
# 本地开发直接复制为 api/.env 使用。

# 数据库（SQLite，容器内相对路径）
DATABASE_URL=sqlite+aiosqlite:///./app.db

# JWT —— 务必改成强随机串！生成命令：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=请替换为强随机串
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 上传目录与限制
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# CORS：同源部署（后端托管前端）可填 * 或部署域名；若前后端不同源则填前台域名，逗号分隔
CORS_ORIGINS=*

# 高德地图 Key（前端使用，可选）
AMAP_KEY=

# 初始管理员（首次启动写入数据库；上线后请尽快在后台改密）
INIT_ADMIN_USER=admin
INIT_ADMIN_PASS=InitAdmin@2026
